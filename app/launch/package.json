{
    "name": "app",
    "version": "0.1.1",
    "private": true,
    "engines": {
        "node": ">=24.20.0"
    },
    "dependencies": {
        "@material-ui/core": "^4.11.4",
        "@material-ui/icons": "^4.11.3",
        "@material-ui/lab": "^4.0.0-alpha.61",
        "lodash": "^4.18.1",
        "react": "^17.0.2",
        "react-dom": "^17.0.2",
        "react-materialize": "^3.10.0",
        "react-syntax-highlighter": "^16.1.1",
        "recoil": "^0.7.7"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.9.1",
        "eslint-plugin-import-x": "^4.17.1",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "react-test-renderer": "^17.0.2",
        "vite": "^8.2.2",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^4.1.11"
    },
    "scripts": {
        "start": "vite",
        "start:local": "VITE_VERSION_FEED='http://localhost:8088/mn-version-feed.json' vite",
        "build": "vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write \"**/*.+(js|jsx|mjs|json|css|md)\"",
        "lint": "eslint './src/**/*.{js,jsx}'",
        "lint:fix": "eslint './src/**/*.{js,jsx}' --fix"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
